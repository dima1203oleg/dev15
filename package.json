{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "lint": "tsc --noEmit",
    "test:financial": "tsx scripts/financial-acceptance-tests.ts",
    "test:spatial": "tsx scripts/spatial-acceptance-tests.ts",
    "test:runtime-boundary": "npm run build && node scripts/runtime-boundary-smoke.mjs",
    "test:database-boundary": "npm run build && node scripts/database-boundary-smoke.mjs",
    "test:postgres-repository": "tsx scripts/postgres-repository-smoke.ts",
    "test:postgres-subscription": "tsx scripts/postgres-subscription-smoke.ts",
    "test:postgres-financial-rule": "tsx scripts/postgres-financial-rule-smoke.ts",
    "test:postgres-payment-adjustment": "tsx scripts/postgres-payment-adjustment-smoke.ts",
    "test:postgres-partner-engagement": "tsx scripts/postgres-partner-engagement-smoke.ts",
    "test:postgres-auto-payout": "tsx scripts/postgres-auto-payout-smoke.ts",
    "test:postgres-qualified-payment": "tsx scripts/postgres-qualified-payment-smoke.ts",
    "test:postgres-payout": "tsx scripts/postgres-payout-smoke.ts",
    "test:postgres-http": "node scripts/postgres-http-smoke.mjs",
    "test:identity": "tsx scripts/identity-acceptance-tests.ts",
    "test:demo-api": "npm run build && node scripts/demo-api-smoke.mjs",
    "test:e2e": "playwright test",
    "test:performance": "npm run build && node scripts/performance-budget.mjs",
    "db:migrate": "node scripts/migrate-postgres.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jose": "^6.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
