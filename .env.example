# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Optional production API origin.
# Leave empty for same-origin local development, for example:
# VITE_API_BASE_URL="https://api.example.com"
VITE_API_BASE_URL="https://sirenua.online"
# Required for authenticated referral stats/tree requests. Use the current
# signed-in user's identifier; do not commit a real user ID to the repository.
VITE_REFERRAL_APPLE_USER_ID=""

# Store links stay empty until the official apps are published.
VITE_APP_STORE_URL=""
VITE_GOOGLE_PLAY_URL=""
# Set only an official, verified channel URL.
VITE_TELEGRAM_URL=""
VITE_YOUTUBE_URL=""
VITE_FACEBOOK_URL=""
VITE_INSTAGRAM_URL=""
